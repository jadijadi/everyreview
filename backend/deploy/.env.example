# Copy to .env (gitignored) on the VPS.

# Hostname pointing at the VPS (A record). Leave empty to serve plain HTTP on :12380
# — then only the *debug* APK can connect (it allows cleartext traffic).
DOMAIN=reviews.example.com

# Pick something random: openssl rand -hex 16
POSTGRES_PASSWORD=change-me

# Optional. Origin the app should fetch uploaded photos from, e.g. https://reviews.example.com
# Normally left empty: the API derives it from the Host / X-Forwarded-Proto headers.
PUBLIC_BASE_URL=

# Password for the stats dashboard at https://$DOMAIN/admin (HTTP basic auth, any username).
# Leave empty to disable the dashboard entirely. Pick something long: openssl rand -base64 24
ADMIN_PASSWORD=
